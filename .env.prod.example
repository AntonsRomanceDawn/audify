# Copy to `.env` next to docker-compose.prod.yml on the VPS and fill in.
# docker compose reads this file automatically.

# Strong password for the dedicated audify Postgres.
POSTGRES_PASSWORD=change-me-strong-db-password

# Mistral / Voxtral.
AUDIFY_MISTRAL_API_KEY=your-mistral-key
AUDIFY_VOICE_ID=e3596645-b1af-469e-b857-f18ddedc7652

# Basic Auth for the podcast feed + audio (what you put in your podcast app).
AUDIFY_BASIC_AUTH_USER=audify
AUDIFY_BASIC_AUTH_PASS=change-me-feed-password
