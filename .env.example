# Copy to .env and fill in. All app config uses the AUDIFY_ prefix.

# Mistral / Voxtral TTS
AUDIFY_MISTRAL_API_KEY=your-key-here
# Base URL for the Mistral API (override if the path changes).
AUDIFY_MISTRAL_BASE_URL=https://api.mistral.ai
AUDIFY_TTS_MODEL=voxtral-mini-tts-2603
# A preset Mistral voice id (set this from your Mistral Studio account).
AUDIFY_VOICE_ID=your-voice-id
# Output format requested from the API: mp3 | wav | pcm | flac | opus
AUDIFY_RESPONSE_FORMAT=mp3

# Where rendered audio is written.
AUDIFY_OUTPUT_DIR=./output

# Postgres connection (matches docker-compose.yml for local dev).
# Used by sqlx at build time to verify queries, and by the app at runtime.
DATABASE_URL=postgres://audify:audify@localhost:5432/audify

# HTTP client timeout for outbound calls, in seconds.
AUDIFY_HTTP_TIMEOUT_SECS=120

# tracing filter (e.g. info, debug, audify=debug)
RUST_LOG=info
