  "query": "\n            INSERT INTO chunks (episode_id, idx, text)\n            VALUES ($1, $2, $3)\n            ON CONFLICT (episode_id, idx) DO UPDATE SET text = EXCLUDED.text\n            RETURNING\n                id AS \"id!\", episode_id AS \"episode_id!\", idx AS \"idx!\",\n                text AS \"text!\", audio_path, status AS \"status!\"\n            ",
