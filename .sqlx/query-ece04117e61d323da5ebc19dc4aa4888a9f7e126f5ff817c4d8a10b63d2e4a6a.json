  "query": "\n            SELECT e.id AS \"id!\", d.title, e.duration_sec, e.created_at AS \"created_at!\"\n            FROM episodes e JOIN documents d ON d.id = e.document_id\n            WHERE e.status = 'ready'\n            ORDER BY e.created_at DESC\n            LIMIT $1\n            ",
